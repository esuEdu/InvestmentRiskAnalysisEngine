meta {
  name: Update Analysis
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/analyses/{{analysisId}}
  body: json
  auth: none
}

body:json {
  {
    "status": "completed"
  }
}

docs {
  Manually updates the status of an analysis request.

  Useful for testing or resetting a stuck job.

  Valid status values:
  - pending
  - processing
  - completed
  - failed
}
