meta {
  name: Create Analysis
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/analyses
  body: json
  auth: none
}

body:json {
  {
    "assets": [
      { "ticker": "AAPL", "weight": 0.40 },
      { "ticker": "MSFT", "weight": 0.35 },
      { "ticker": "GOOGL", "weight": 0.25 }
    ],
    "benchmark": "SPY",
    "period": "3m"
  }
}

docs {
  Creates a new analysis request and queues it for async processing.
  
  Returns 202 Accepted — the job is queued, not yet completed.
  Poll GET /analyses/:id until status changes to "completed", then call
  GET /analyses/:id/results to retrieve the computed metrics.
  
  Fields:
  - assets      (required) — array of portfolio assets, weights must sum to 1.0
    - ticker    (required) — asset symbol, e.g. "AAPL"
    - weight    (required) — allocation weight between 0 and 1
  - benchmark   (optional) — ticker to compare against for Beta, e.g. "SPY"
  - period      (required) — look-back window: "1m", "3m", "6m", "1y", "2y"
}
