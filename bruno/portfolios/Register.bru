meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{portfolioBaseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}

docs {
  Register a new user. Automatically stores the returned JWT in the `token` variable.
}
