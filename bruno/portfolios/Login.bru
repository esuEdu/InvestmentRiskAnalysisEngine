meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{portfolioBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.data.token);
  }
}

docs {
  Login and receive a JWT. Stores the token in the `token` variable.
}
